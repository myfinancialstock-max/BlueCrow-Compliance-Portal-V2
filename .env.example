# Copiar para .env e preencher — o .env NUNCA deve ser commitado no Git

# PostgreSQL
# Desenvolvimento local:  @localhost:5432
# Com Docker Compose:     @db:5432  (substituído automaticamente pelo docker-compose.yml)
DATABASE_URL=postgresql://postgres:bluecrow@localhost:5432/compliance_portal

# JWT — gerar chave segura: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUIR_POR_CHAVE_SEGURA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_NAME=BlueCrow Compliance Portal
DEBUG=true
